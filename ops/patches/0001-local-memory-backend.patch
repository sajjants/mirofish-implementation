index 0000000..7f4465f
--- /dev/null
+++ b/backend/app/local_graph/embedder.py
@@ -0,0 +1,61 @@
+"""Text embeddings from a local Ollama server (``/api/embed``).
+
+Only loopback endpoints are accepted so graph text cannot be embedded off-machine.
+"""
+
+from __future__ import annotations
+
+import os
+from typing import List, Optional, Sequence
+from urllib.parse import urlparse
+
+import httpx
+import numpy as np
+
+LOOPBACK_HOSTS = {"127.0.0.1", "localhost", "::1"}
+_BATCH_SIZE = 32
+_MAX_INPUT_CHARS = 2000
+
+
+class EmbeddingError(RuntimeError):
+    pass
+
+
+class OllamaEmbedder:
+    """Return L2-normalised float32 vectors for a list of texts."""
+
+    def __init__(
+        self,
+        base_url: Optional[str] = None,
+        model: Optional[str] = None,
+        timeout: float = 120.0,
+    ):
+        self.base_url = (base_url or os.environ.get("LOCAL_GRAPH_EMBED_URL") or "http://127.0.0.1:11434").rstrip("/")
+        self.model = model or os.environ.get("LOCAL_GRAPH_EMBED_MODEL") or "mirofish-embed"
+        host = urlparse(self.base_url).hostname
+        if host not in LOOPBACK_HOSTS:
+            raise ValueError(f"LOCAL_GRAPH_EMBED_URL must point at a loopback host, got {host!r}")
+        # trust_env=False: never route embedding requests through proxy environment variables.
+        self._client = httpx.Client(timeout=timeout, trust_env=False)
+
+    def embed(self, texts: Sequence[str]) -> np.ndarray:
+        if not texts:
+            return np.zeros((0, 0), dtype=np.float32)
+        vectors: List[List[float]] = []
+        for start in range(0, len(texts), _BATCH_SIZE):
+            chunk = [(t or " ")[:_MAX_INPUT_CHARS] for t in texts[start:start + _BATCH_SIZE]]
+            try:
+                response = self._client.post(
+                    f"{self.base_url}/api/embed", json={"model": self.model, "input": chunk}
+                )
+                response.raise_for_status()
+                batch = response.json()["embeddings"]
+            except (httpx.HTTPError, KeyError, ValueError) as error:
+                raise EmbeddingError(f"local embedding request failed: {error}") from error
+            if len(batch) != len(chunk):
+                raise EmbeddingError("embedding count does not match input count")
+            vectors.extend(batch)
+        matrix = np.asarray(vectors, dtype=np.float32)
+        norms = np.linalg.norm(matrix, axis=1, keepdims=True)
+        norms[norms == 0] = 1.0
+        return matrix / norms
diff --git a/backend/app/local_graph/extractor.py b/backend/app/local_graph/extractor.py
