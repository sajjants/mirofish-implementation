+"""Background ingestion so the Batch API and ``graph.add`` stay asynchronous, as in Zep."""
+
+from __future__ import annotations
+
+import os
+import queue
+import threading
+from typing import Dict, List, Optional, Tuple
+
+from ..utils.logger import get_logger
+from .ingest import GraphIngestor, WindowOutcome
+from .store import GraphDeletedError, GraphStore
+
+logger = get_logger("mirofish.local_graph.worker")
+
+EXTRACTION_FAILED = "extraction_failed"
+# With strict extraction off (default), a chunk the LLM cannot turn into valid JSON is recorded
+# on its episode and the build continues, unless more than MAX_EXTRACTION_FAILURE_RATIO of the
+# batch failed, in which case the batch fails rather than yielding a hollow graph.
+STRICT_EXTRACTION = os.environ.get("LOCAL_GRAPH_STRICT_EXTRACTION", "0") == "1"
+MAX_EXTRACTION_FAILURE_RATIO = float(os.environ.get("LOCAL_GRAPH_MAX_EXTRACTION_FAILURE_RATIO", "0.5"))
+
+
+def _item_status(error: Optional[str]) -> str:
+    if error is None:
+        return "succeeded"
+    if error.startswith(EXTRACTION_FAILED) and not STRICT_EXTRACTION:
+        return "succeeded"
+    return "failed"
+
+
+class IngestWorker:
+    def __init__(self, store: GraphStore, ingestor: GraphIngestor):
+        self.store = store
+        self.ingestor = ingestor
+        self._jobs: "queue.Queue[Tuple[str, str]]" = queue.Queue()
+        self._thread = threading.Thread(target=self._run, name="local-graph-ingest", daemon=True)
+        self._thread.start()
+
+    # ---------------------------------------------------------------- scheduling
+
+    def submit_batch(self, batch_id: str) -> None:
+        self._jobs.put(("batch", batch_id))
+
+    def submit_episode(self, episode_uuid: str) -> None:
+        self._jobs.put(("episode", episode_uuid))
+
+    def recover(self) -> None:
+        """Re-queue work interrupted by a backend restart."""
+        for batch in self.store.batches_with_status("processing"):
+            self.submit_batch(batch.batch_id)
+        for episode in self.store.unprocessed_standalone_episodes():
+            self.submit_episode(episode.uuid_)
+
+    def wait_idle(self, timeout: Optional[float] = None) -> bool:
+        """Block until queued work is done (used by tests)."""
+        done = threading.Event()
+
+        def waiter():
+            self._jobs.join()
+            done.set()
+
+        threading.Thread(target=waiter, daemon=True).start()
+        return done.wait(timeout)
+
+    # ------------------------------------------------------------------- running
+
+    def _run(self) -> None:
+        while True:
+            kind, ident = self._jobs.get()
+            try:
+                if kind == "batch":
+                    self._process_batch(ident)
+                else:
+                    self._process_episodes([ident])
+            except Exception:  # noqa: BLE001 - keep the worker alive
+                logger.exception("local graph ingestion job %s %s crashed", kind, ident)
+            finally:
+                self._jobs.task_done()
+
+    def _process_batch(self, batch_id: str) -> None:
+        by_graph: Dict[str, List] = {}
+        for item in self.store.list_batch_items(batch_id):
+            if item.status == "pending":
+                by_graph.setdefault(item.graph_id, []).append(item)
+
+        for graph_id, graph_items in by_graph.items():
+            index_by_episode = {i.episode_uuid: i.sequence_index for i in graph_items}
+            if self.store.get_graph(graph_id) is None:
+                self.store.set_items_status(batch_id, index_by_episode.values(), "failed", "graph not found")
+                continue
+            episodes = []
+            for episode in self.store.get_episodes(index_by_episode):
+                if episode.processed:  # finished before a restart; do not extract twice
+                    index = index_by_episode[episode.uuid_]
+                    self.store.set_items_status(batch_id, [index], _item_status(episode.error), episode.error)
+                else:
+                    episodes.append(episode)
+            try:
+                for outcome in self.ingestor.ingest(graph_id, episodes):
+                    self._record(outcome, batch_id, index_by_episode)
+            except GraphDeletedError:
+                logger.info("local graph %s was deleted during batch %s; stopping", graph_id, batch_id)
+            except Exception as error:  # noqa: BLE001 - infrastructure failure fails this graph's items
+                logger.error("local graph batch %s failed: %s", batch_id, error)
+                pending = [i.sequence_index for i in self.store.list_batch_items(batch_id)
+                           if i.status == "pending" and i.graph_id == graph_id]
+                self.store.set_items_status(batch_id, pending, "failed", f"{type(error).__name__}: {error}")
+
+        self._finish_batch(batch_id)
+
+    def _finish_batch(self, batch_id: str) -> None:
+        items = self.store.list_batch_items(batch_id)
+        extraction_failures = [i for i in items if i.status == "succeeded" and (i.error or "").startswith(EXTRACTION_FAILED)]
+        if items and len(extraction_failures) / len(items) > MAX_EXTRACTION_FAILURE_RATIO:
+            logger.error("local graph batch %s: %d of %d chunks could not be extracted",
+                         batch_id, len(extraction_failures), len(items))
+            self.store.set_items_status(batch_id, [i.sequence_index for i in extraction_failures], "failed",
+                                        extraction_failures[0].error)
+            items = self.store.list_batch_items(batch_id)
+        failed = sum(1 for i in items if i.status == "failed")
+        status = "succeeded" if failed == 0 else ("failed" if failed == len(items) else "partial")
+        self.store.set_batch_status(batch_id, status)
+        logger.info("local graph batch %s %s (%d items, %d failed)", batch_id, status, len(items), failed)
+
+    def _process_episodes(self, episode_uuids: List[str]) -> None:
+        episodes = [e for e in self.store.get_episodes(episode_uuids) if not e.processed]
+        by_graph: Dict[str, list] = {}
+        for episode in episodes:
+            by_graph.setdefault(episode.graph_id, []).append(episode)
+        for graph_id, graph_episodes in by_graph.items():
+            if self.store.get_graph(graph_id) is None:
+                self.store.mark_episodes([e.uuid_ for e in graph_episodes], error="graph not found")
+                continue
+            try:
+                for outcome in self.ingestor.ingest(graph_id, graph_episodes):
+                    self._record(outcome)
+            except GraphDeletedError:
+                logger.info("local graph %s was deleted during episode ingestion; stopping", graph_id)
+            except Exception as error:  # noqa: BLE001 - mark processed so pollers do not hang
+                logger.error("local graph episode ingestion failed: %s", error)
+                pending = [e.uuid_ for e in self.store.get_episodes([g.uuid_ for g in graph_episodes]) if not e.processed]
+                self.store.mark_episodes(pending, error=f"{type(error).__name__}: {error}")
+
+    def _record(
+        self,
+        outcome: WindowOutcome,
+        batch_id: Optional[str] = None,
+        index_by_episode: Optional[Dict[str, int]] = None,
+    ) -> None:
+        error = None if outcome.ok else f"{EXTRACTION_FAILED}: {outcome.error}"
+        with self.store.transaction():
+            self.store.mark_episodes(outcome.episode_uuids, error=error)
+            if batch_id is not None and index_by_episode is not None:
+                indexes = [index_by_episode[u] for u in outcome.episode_uuids]
+                self.store.set_items_status(batch_id, indexes, _item_status(error), error)
