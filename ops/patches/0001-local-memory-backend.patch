+from app import local_graph
+from app.config import Config
+from app.local_graph import build_local_graph_client
+from app.local_graph.embedder import EmbeddingError, OllamaEmbedder
+from app.local_graph.extractor import OntologyExtractor, name_is_grounded, normalize_name_key
+from app.utils import zep as zep_utils
+
+KNOWN_ENTITIES = {
+    "Dana Ortiz": ("Person", "Dana Ortiz is the mayor of Riverton."),
+    "Riverton Council": ("Organization", "Riverton Council governs the town."),
+    "Sam Lee": ("Person", "Sam Lee is a local reporter."),
+    "Harbor Times": ("MediaOutlet", "Harbor Times is a newspaper."),
+}
+
+ONTOLOGY = {
+    "entity_types": [
+        {"name": "Person", "description": "An individual", "attributes": [{"name": "role", "description": "Role"}]},
+        {"name": "Organization", "description": "An organisation", "attributes": []},
+        {"name": "MediaOutlet", "description": "A news outlet", "attributes": []},
+    ],
+    "edge_types": [
+        {
+            "name": "LEADS",
+            "description": "Leads an organisation",
+            "attributes": [],
+            "source_targets": [{"source": "Person", "target": "Organization"}],
+        },
+        {
+            "name": "WRITES_FOR",
+            "description": "Works for an outlet",
+            "attributes": [],
+            "source_targets": [{"source": "Person", "target": "MediaOutlet"}],
+        },
+    ],
+}
+
+DOCUMENT_CHUNKS = [
+    "Dana Ortiz chairs the Riverton Council and proposed a new harbour levy.",
+    "Sam Lee writes for the Harbor Times and criticised the levy proposed by Dana Ortiz.",
+    "The Riverton Council will vote on the levy next month.",
+]
+
+
+class FakeLLM:
+    """Returns entities from KNOWN_ENTITIES that occur in the prompt, plus one hallucination."""
+
+    def __init__(self, fail_on=None, on_call=None):
+        self.calls = 0
+        self.fail_on = fail_on
+        self.on_call = on_call
+        self.prompts = []
+        self.lock = threading.Lock()
+
+    def chat_json(self, messages, temperature=0.3, max_tokens=4096, max_attempts=1):
+        with self.lock:
+            self.calls += 1
+            self.prompts.append(messages[-1]["content"])
+        if self.on_call:
+            self.on_call(self.calls)
+        source = re.search(r"<source_text>\n(.*)\n</source_text>", messages[-1]["content"], re.S).group(1)
+        if self.fail_on and self.fail_on in source:
+            raise ValueError("LLM returned invalid JSON")
+        entities = [
+            {"name": name, "type": etype, "summary": summary, "attributes": {"role": "mayor", "bogus": "x"}}
+            for name, (etype, summary) in KNOWN_ENTITIES.items()
+            if name in source
+        ]
+        entities.append({"name": "Ghost Corp", "type": "Organization", "summary": "Not in the text."})
+        relations = []
+        if "Dana Ortiz" in source and "Riverton Council" in source:
+            relations.append({"source": "Dana Ortiz", "target": "Riverton Council", "type": "leads",
+                              "fact": "Dana Ortiz chairs the Riverton Council."})
+        if "Sam Lee" in source and "Harbor Times" in source:
+            relations.append({"source": "Sam Lee", "target": "Harbor Times", "type": "WRITES_FOR",
+                              "fact": "Sam Lee writes for the Harbor Times."})
+            relations.append({"source": "Sam Lee", "target": "Ghost Corp", "type": "WRITES_FOR",
+                              "fact": "Hallucinated relation."})
+        return {"entities": entities, "relations": relations}
+
+
+class FakeEmbedder:
+    """Hashed bag-of-words vectors: deterministic and similarity-preserving enough for ranking."""
+
+    dim = 64
+
+    def __init__(self, fail=False):
+        self.fail = fail
+
+    def embed(self, texts):
+        if self.fail:
+            raise EmbeddingError("embedding server unreachable")
+        out = np.zeros((len(texts), self.dim), dtype=np.float32)
+        for row, text in enumerate(texts):
+            for token in re.findall(r"\w+", text.lower()):
+                out[row, int(hashlib.sha256(token.encode()).hexdigest(), 16) % self.dim] += 1.0
+        norms = np.linalg.norm(out, axis=1, keepdims=True)
+        norms[norms == 0] = 1.0
+        return out / norms
+
+
+@pytest.fixture
+def local_client(tmp_path, monkeypatch):
+    llm = FakeLLM()
+    client = build_local_graph_client(
+        str(tmp_path / "graph.sqlite3"),
+        embedder=FakeEmbedder(),
+        extractor=OntologyExtractor(llm_client=llm),
+    )
+    client.fake_llm = llm
+    monkeypatch.setattr(Config, "MEMORY_BACKEND", "local")
+    monkeypatch.setattr(local_graph, "_client", client)
+    yield client
+    client.store.close()
+
+
+def _build_graph(client, chunks=DOCUMENT_CHUNKS):
+    from app.services.graph_builder import GraphBuilderService
+
+    builder = GraphBuilderService(api_key="local-graph")
+    assert builder.client is client
+    graph_id = builder.create_graph("Test graph")
+    builder.set_ontology(graph_id, ONTOLOGY)
+    submission = builder.add_text_batches(graph_id, list(chunks), batch_size=2)
+    assert client.worker.wait_idle(timeout=30)
+    episode_uuids = builder._wait_for_batch(submission, timeout=10)
+    return builder, graph_id, episode_uuids
+
