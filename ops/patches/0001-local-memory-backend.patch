+def test_graph_builder_end_to_end_with_upstream_service(local_client):
+    builder, graph_id, episode_uuids = _build_graph(local_client)
+
+    assert len(episode_uuids) == len(DOCUMENT_CHUNKS)
+    data = builder.get_graph_data(graph_id)
+    names = {n["name"]: n for n in data["nodes"]}
+    assert set(names) == set(KNOWN_ENTITIES)
+    assert "Ghost Corp" not in names
+    assert names["Dana Ortiz"]["labels"] == ["Entity", "Person"]
+    assert names["Harbor Times"]["labels"] == ["Entity", "MediaOutlet"]
+    assert names["Dana Ortiz"]["attributes"] == {"role": "mayor"}
+
+    facts = {(e["name"], e["fact"]) for e in data["edges"]}
+    assert ("LEADS", "Dana Ortiz chairs the Riverton Council.") in facts
+    assert ("WRITES_FOR", "Sam Lee writes for the Harbor Times.") in facts
+    assert all("Hallucinated" not in fact for _, fact in facts)
+
+    leads = next(e for e in data["edges"] if e["name"] == "LEADS")
+    assert leads["source_node_uuid"] == names["Dana Ortiz"]["uuid"]
+    assert leads["target_node_uuid"] == names["Riverton Council"]["uuid"]
+
+    for episode_uuid in episode_uuids:
+        assert local_client.graph.episode.get(uuid_=episode_uuid).processed is True
