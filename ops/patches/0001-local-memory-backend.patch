+++ b/backend/app/local_graph/ingest.py
@@ -0,0 +1,215 @@
+"""Turn episodes into graph nodes and edges: extract, resolve entities, embed, upsert.
+
+LLM and embedding calls run outside the store lock. Each window's writes then commit in one
+transaction that first checks the graph still exists, so a graph deleted mid-ingest never
+gets rows written back under its id.
+"""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+import numpy as np
+
+from ..utils.logger import get_logger
+from .extractor import (
+    GENERIC_ENTITY_TYPE,
+    OntologyExtractor,
+    normalize_fact_key,
+    normalize_name_key,
+)
+from .models import Episode, Node
+from .store import GraphDeletedError, GraphStore
+
+logger = get_logger("mirofish.local_graph.ingest")
+
+MAX_WINDOW_CHARS = int(os.environ.get("LOCAL_GRAPH_WINDOW_CHARS", "4000"))
+MAX_WINDOW_EPISODES = int(os.environ.get("LOCAL_GRAPH_WINDOW_EPISODES", "8"))
+MERGE_THRESHOLD = float(os.environ.get("LOCAL_GRAPH_MERGE_THRESHOLD", "0.90"))
+SUMMARY_FACTS = 5
+SUMMARY_MAX_CHARS = 600
+
+
+def node_text(name: str, summary: str) -> str:
+    return f"{name}: {summary}" if summary else name
+
+
+def build_windows(episodes: Sequence[Episode]) -> List[List[Episode]]:
+    """Group consecutive episodes into extraction windows bounded by size and count."""
+    windows: List[List[Episode]] = []
+    current: List[Episode] = []
+    size = 0
+    for episode in episodes:
+        length = len(episode.content)
+        if current and (size + length > MAX_WINDOW_CHARS or len(current) >= MAX_WINDOW_EPISODES):
+            windows.append(current)
+            current, size = [], 0
+        current.append(episode)
+        size += length
+    if current:
+        windows.append(current)
+    return windows
+
+
+@dataclass
+class WindowOutcome:
+    episode_uuids: List[str]
+    ok: bool
+    error: Optional[str] = None
+
+
+class GraphIngestor:
+    def __init__(self, store: GraphStore, extractor: OntologyExtractor, embedder: Any):
+        self.store = store
+        self.extractor = extractor
+        self.embedder = embedder
+
+    def ingest(self, graph_id: str, episodes: Sequence[Episode]) -> List[WindowOutcome]:
+        """Raises GraphDeletedError as soon as the graph disappears."""
+        ontology = self.store.get_ontology(graph_id)
+        outcomes = []
+        for window in build_windows(episodes):
+            outcomes.extend(self._ingest_window_with_split(graph_id, window, ontology))
+        return outcomes
+
+    def _ingest_window_with_split(self, graph_id: str, window: List[Episode], ontology: Dict[str, Any]) -> List[WindowOutcome]:
+        # Only malformed model output is tolerated here (LLMResponseError and JSON errors are
+        # ValueErrors). Connection, embedding and GraphDeleted errors propagate and stop the job.
+        try:
+            return [self._ingest_window(graph_id, window, ontology)]
+        except (ValueError, KeyError, TypeError) as error:
+            if len(window) == 1:
+                logger.warning("local graph extraction failed for episode %s: %s", window[0].uuid_, error)
+                return [WindowOutcome([window[0].uuid_], ok=False, error=f"{type(error).__name__}: {error}")]
+            logger.warning("local graph extraction failed for a %d-episode window; retrying one by one", len(window))
+            outcomes = []
+            for episode in window:
+                outcomes.extend(self._ingest_window_with_split(graph_id, [episode], ontology))
+            return outcomes
+
+    def _ingest_window(self, graph_id: str, window: List[Episode], ontology: Dict[str, Any]) -> WindowOutcome:
+        episode_uuids = [e.uuid_ for e in window]
+        if self.store.get_graph(graph_id) is None:
+            raise GraphDeletedError(graph_id)
+
+        result = self.extractor.extract([e.content for e in window], ontology)
+        if not result.entities:
+            return WindowOutcome(episode_uuids, ok=True)
+        texts = [node_text(e["name"], e["summary"]) for e in result.entities] + [r["fact"] for r in result.relations]
+        vectors = self.embedder.embed(texts)
+        entity_vectors, fact_vectors = vectors[: len(result.entities)], vectors[len(result.entities):]
+
+        with self.store.transaction():
+            self.store.require_graph(graph_id)
+            to_embed = self._write_window(graph_id, window, result, entity_vectors, fact_vectors)
+
+        if to_embed:
+            new_vectors = self.embedder.embed([text for _, text in to_embed])
+            with self.store.transaction():
+                self.store.require_graph(graph_id)
+                for (node_uuid, _), vector in zip(to_embed, new_vectors):
+                    self.store.set_node_embedding(node_uuid, vector)
+        return WindowOutcome(episode_uuids, ok=True)
+
+    def _write_window(self, graph_id, window, result, entity_vectors, fact_vectors) -> List[Tuple[str, str]]:
+        """Upsert nodes and edges; return (node_uuid, text) pairs whose embedding must be refreshed."""
+        episode_uuids = [e.uuid_ for e in window]
+        created_at = window[0].created_at
+        existing: Dict[str, Tuple[Node, Optional[np.ndarray]]] = {
+            node.uuid_: (node, vector) for node, vector in self.store.node_vectors(graph_id)
+        }
+        name_to_uuid: Dict[str, str] = {}
+        touched: List[str] = []
+        reembed: Dict[str, str] = {}
+
+        for entity, vector in zip(result.entities, entity_vectors):
+            node = self._resolve(graph_id, entity, vector, existing)
+            if node is None:
+                labels = ["Entity"] if entity["type"] == GENERIC_ENTITY_TYPE else ["Entity", entity["type"]]
+                node = self.store.insert_node(
+                    graph_id, entity["name"], normalize_name_key(entity["name"]), labels,
+                    entity["summary"], entity["attributes"], vector, created_at,
+                )
+            elif self._merge_into(node, entity):
+                reembed[node.uuid_] = node_text(node.name, entity["summary"])
+            node = self.store.get_node(node.uuid_)
+            existing[node.uuid_] = (node, existing.get(node.uuid_, (None, vector))[1])
+            name_to_uuid[normalize_name_key(entity["name"])] = node.uuid_
+            if node.uuid_ not in touched:
+                touched.append(node.uuid_)
+
+        for relation, vector in zip(result.relations, fact_vectors):
+            source_uuid = name_to_uuid[normalize_name_key(relation["source"])]
+            target_uuid = name_to_uuid[normalize_name_key(relation["target"])]
+            if source_uuid == target_uuid:
+                continue
+            fact_key = normalize_fact_key(relation["fact"])
+            found = self.store.find_edge(graph_id, source_uuid, target_uuid, relation["type"], fact_key)
+            if found:
+                self.store.add_edge_episodes(found.uuid_, episode_uuids)
+            else:
+                self.store.insert_edge(
+                    graph_id, relation["type"], relation["fact"], fact_key, source_uuid, target_uuid,
+                    {}, list(episode_uuids), vector, created_at, created_at,
+                )
+
+        reembed.update(self._refresh_fact_summaries(touched))
+        return list(reembed.items())
+
+    def _resolve(self, graph_id: str, entity: Dict[str, Any], vector: np.ndarray, existing) -> Optional[Node]:
+        key = normalize_name_key(entity["name"])
+        exact = self.store.find_node_by_key(graph_id, key)
+        if exact is not None:
+            return exact
+        tokens = {t for t in key.split() if len(t) >= 3}
+        best, best_score = None, MERGE_THRESHOLD
+        for node, node_vector in existing.values():
+            if node_vector is None or node_vector.size != vector.size:
+                continue
+            node_type = next((l for l in node.labels if l != "Entity"), GENERIC_ENTITY_TYPE)
+            if entity["type"] != GENERIC_ENTITY_TYPE and node_type not in (entity["type"], GENERIC_ENTITY_TYPE):
+                continue
+            if not tokens & {t for t in normalize_name_key(node.name).split() if len(t) >= 3}:
+                continue
+            score = float(node_vector @ vector)
+            if score >= best_score:
+                best, best_score = node, score
+        return best
+
+    def _merge_into(self, node: Node, entity: Dict[str, Any]) -> bool:
+        """Merge an extracted entity into an existing node; True if its summary was replaced."""
+        labels = list(node.labels)
+        if entity["type"] != GENERIC_ENTITY_TYPE and all(l == "Entity" for l in labels):
+            labels.append(entity["type"])
+        attributes = dict(entity["attributes"])
+        attributes.update(node.attributes)
+        updates: Dict[str, Any] = {}
+        if labels != node.labels:
+            updates["labels"] = labels
+        if attributes != node.attributes:
+            updates["attributes"] = attributes
+        summary_replaced = bool(entity["summary"]) and self.store.node_summary_from_facts(node.uuid_)
+        if summary_replaced:
+            updates["summary"] = entity["summary"]
+            updates["summary_from_facts"] = False
+        if updates:
+            self.store.update_node(node.uuid_, **updates)
+        return summary_replaced
+
+    def _refresh_fact_summaries(self, node_uuids: List[str]) -> Dict[str, str]:
+        """Nodes without an LLM summary get one built from their first few facts."""
+        changed: Dict[str, str] = {}
+        for node_uuid in node_uuids:
+            if not self.store.node_summary_from_facts(node_uuid):
+                continue
+            facts = [e.fact for e in self.store.edges_for_node(node_uuid)][:SUMMARY_FACTS]
+            if not facts:
+                continue
+            summary = " ".join(facts)[:SUMMARY_MAX_CHARS]
+            node = self.store.get_node(node_uuid)
+            if summary != node.summary:
+                self.store.update_node(node_uuid, summary=summary)
+                changed[node_uuid] = node_text(node.name, summary)
+        return changed
