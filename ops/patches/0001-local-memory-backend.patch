+def test_embedder_refuses_non_loopback_url():
+    with pytest.raises(ValueError):
+        OllamaEmbedder(base_url="http://example.com:11434")
+    with pytest.raises(ValueError):
+        OllamaEmbedder(base_url="http://192.168.1.10:11434")
