+"""Hybrid ranking: BM25 keyword scores and cosine similarity, fused by reciprocal rank.
+
+Replaces Zep's ``rrf`` and ``cross_encoder`` rerankers; both map to the same fusion here.
+"""
+
+from __future__ import annotations
+
+import math
+import re
+from collections import Counter
+from typing import Any, List, Optional, Sequence, Tuple
+
+import numpy as np
+
+_RRF_K = 60
+_WORD = re.compile(r"\w+", re.UNICODE)
+_CJK = re.compile(r"[\u3040-\u30ff\u3400-\u4dbf\u4e00-\u9fff\uac00-\ud7af]")
+
+
+def tokenize(text: str) -> List[str]:
+    """Lower-case word tokens; CJK runs are split into single characters."""
+    tokens: List[str] = []
+    for match in _WORD.findall((text or "").lower()):
+        if _CJK.search(match):
+            tokens.extend(ch for ch in match if not ch.isspace())
+        else:
+            tokens.append(match)
+    return tokens
+
+
+def bm25_scores(query: str, documents: Sequence[str], k1: float = 1.5, b: float = 0.75) -> np.ndarray:
+    query_terms = set(tokenize(query))
+    if not documents or not query_terms:
+        return np.zeros(len(documents), dtype=np.float64)
+    tokenized = [tokenize(d) for d in documents]
+    lengths = np.array([len(t) for t in tokenized], dtype=np.float64)
+    avg_len = lengths.mean() if lengths.size and lengths.mean() > 0 else 1.0
+    doc_freq = Counter(term for tokens in tokenized for term in set(tokens) if term in query_terms)
+    n_docs = len(documents)
+    scores = np.zeros(n_docs, dtype=np.float64)
+    for i, tokens in enumerate(tokenized):
+        counts = Counter(tokens)
+        for term in query_terms:
+            tf = counts.get(term, 0)
+            if not tf:
+                continue
+            idf = math.log(1 + (n_docs - doc_freq[term] + 0.5) / (doc_freq[term] + 0.5))
+            scores[i] += idf * tf * (k1 + 1) / (tf + k1 * (1 - b + b * lengths[i] / avg_len))
+    return scores
+
+
+def hybrid_rank(
+    query: str,
+    query_vector: Optional[np.ndarray],
+    candidates: Sequence[Tuple[Any, str, Optional[np.ndarray]]],
+    limit: int,
+) -> List[Any]:
+    """Rank (item, text, vector) candidates and return up to ``limit`` items."""
+    if not candidates or limit < 1:
+        return []
+    fused = np.zeros(len(candidates), dtype=np.float64)
+
+    keyword = bm25_scores(query, [text for _, text, _ in candidates])
+    keyword_order = [i for i in np.argsort(-keyword, kind="stable") if keyword[i] > 0]
+    for rank, i in enumerate(keyword_order):
+        fused[i] += 1.0 / (_RRF_K + rank + 1)
+
+    if query_vector is not None:
+        with_vectors = [i for i, (_, _, vec) in enumerate(candidates) if vec is not None and vec.size == query_vector.size]
+        if with_vectors:
+            matrix = np.stack([candidates[i][2] for i in with_vectors])
+            similarity = matrix @ query_vector
+            for rank, j in enumerate(np.argsort(-similarity, kind="stable")):
+                fused[with_vectors[j]] += 1.0 / (_RRF_K + rank + 1)
+
+    order = [i for i in np.argsort(-fused, kind="stable") if fused[i] > 0]
+    return [candidates[i][0] for i in order[:limit]]
