+def test_local_backend_needs_no_zep_key_and_never_builds_cloud_client(local_client, monkeypatch):
+    monkeypatch.setattr(Config, "ZEP_API_KEY", "local-graph")
+    monkeypatch.setattr(Config, "LLM_API_KEY", "ollama-local")
+    assert "ZEP_API_KEY" not in " ".join(Config.validate())
