+"""Contract tests for the local graph-memory backend (MIROFISH_MEMORY_BACKEND=local).
+
+The LLM and embedder are deterministic fakes, so no network or model is needed. Upstream
+services are driven unchanged against the local client to prove drop-in compatibility.
+"""
+
+import hashlib
+import re
+import threading
+import uuid
+
+import numpy as np
+import pytest
+from zep_cloud import NotFoundError
