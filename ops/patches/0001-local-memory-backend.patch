+def test_graph_deleted_during_ingestion_leaves_no_rows(tmp_path):
+    from zep_cloud.types import BatchAddItem
+
+    marker = "Zyxwv Quorlington"
+    holder = {}
+
+    def delete_graph_on_first_call(call_number):
+        if call_number == 1:
+            holder["client"].graph.delete("g1")
+
+    client = build_local_graph_client(
+        str(tmp_path / "g.sqlite3"), embedder=FakeEmbedder(),
+        extractor=OntologyExtractor(llm_client=FakeLLM(on_call=delete_graph_on_first_call)),
+    )
+    holder["client"] = client
+    client.graph.create(graph_id="g1", name="g1")
+    client.store.set_ontology("g1", ONTOLOGY)
+    batch = client.batch.create(metadata={"graph_id": "g1"})
+    chunks = DOCUMENT_CHUNKS + [f"{marker} chairs the Riverton Council."] * 20
+    client.batch.add(batch_id=batch.batch_id, items=[
+        BatchAddItem(type="graph_episode", graph_id="g1", data=c, data_type="text") for c in chunks
+    ])
+    client.batch.process(batch_id=batch.batch_id)
+    assert client.worker.wait_idle(timeout=10)
+
+    for table in ("graphs", "episodes", "nodes", "edges", "batch_items", "batches"):
+        assert client.store._query(f"SELECT COUNT(*) FROM {table}")[0][0] == 0
+    assert marker.encode() not in (tmp_path / "g.sqlite3").read_bytes()
+    client.store.close()
+
