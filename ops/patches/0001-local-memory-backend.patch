+"""SQLite persistence for the local graph backend.
+
+One connection guarded by a re-entrant lock; every statement is parameterised.
+Embeddings are stored as float32 blobs and compared in numpy by search.py.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import json
+import os
+import sqlite3
+import threading
+import uuid
+from contextlib import contextmanager
+from datetime import datetime, timezone
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple
+
+import numpy as np
+
+from .models import Batch, BatchItem, BatchProgress, Edge, Episode, Graph, Node
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS graphs (
+    graph_id TEXT PRIMARY KEY,
+    name TEXT NOT NULL,
+    description TEXT NOT NULL DEFAULT '',
+    ontology_json TEXT,
+    created_at TEXT NOT NULL
+);
+CREATE TABLE IF NOT EXISTS episodes (
+    uuid TEXT PRIMARY KEY,
+    graph_id TEXT NOT NULL,
+    content TEXT NOT NULL,
+    source_description TEXT NOT NULL DEFAULT '',
+    metadata_json TEXT NOT NULL DEFAULT '{}',
+    created_at TEXT NOT NULL,
+    processed INTEGER NOT NULL DEFAULT 0,
+    error TEXT
+);
+CREATE INDEX IF NOT EXISTS idx_episodes_graph ON episodes(graph_id);
+CREATE TABLE IF NOT EXISTS nodes (
+    uuid TEXT PRIMARY KEY,
+    graph_id TEXT NOT NULL,
+    name TEXT NOT NULL,
+    name_key TEXT NOT NULL,
+    labels_json TEXT NOT NULL,
+    summary TEXT NOT NULL DEFAULT '',
+    summary_from_facts INTEGER NOT NULL DEFAULT 1,
+    attributes_json TEXT NOT NULL DEFAULT '{}',
+    embedding BLOB,
+    created_at TEXT NOT NULL,
+    seq INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_nodes_graph ON nodes(graph_id, seq);
+CREATE INDEX IF NOT EXISTS idx_nodes_key ON nodes(graph_id, name_key);
+CREATE TABLE IF NOT EXISTS edges (
+    uuid TEXT PRIMARY KEY,
+    graph_id TEXT NOT NULL,
+    name TEXT NOT NULL,
+    fact TEXT NOT NULL,
+    fact_key TEXT NOT NULL,
+    source_uuid TEXT NOT NULL,
+    target_uuid TEXT NOT NULL,
+    attributes_json TEXT NOT NULL DEFAULT '{}',
+    episodes_json TEXT NOT NULL DEFAULT '[]',
+    embedding BLOB,
+    created_at TEXT NOT NULL,
+    valid_at TEXT,
+    seq INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_edges_graph ON edges(graph_id, seq);
+CREATE INDEX IF NOT EXISTS idx_edges_source ON edges(source_uuid);
+CREATE INDEX IF NOT EXISTS idx_edges_target ON edges(target_uuid);
+CREATE TABLE IF NOT EXISTS batches (
+    batch_id TEXT PRIMARY KEY,
+    status TEXT NOT NULL,
+    metadata_json TEXT NOT NULL DEFAULT '{}',
+    created_at TEXT NOT NULL,
+    seq INTEGER NOT NULL
+);
+CREATE TABLE IF NOT EXISTS batch_items (
+    batch_id TEXT NOT NULL,
+    sequence_index INTEGER NOT NULL,
+    graph_id TEXT NOT NULL,
+    status TEXT NOT NULL,
+    episode_uuid TEXT NOT NULL,
+    error TEXT,
+    PRIMARY KEY (batch_id, sequence_index)
+);
+"""
+
+
+def utc_now() -> str:
+    return datetime.now(timezone.utc).isoformat()
+
+
+def _vec_to_blob(vector: Optional[np.ndarray]) -> Optional[bytes]:
+    if vector is None:
+        return None
+    return np.asarray(vector, dtype=np.float32).tobytes()
+
+
+def _blob_to_vec(blob: Optional[bytes]) -> Optional[np.ndarray]:
+    if blob is None:
+        return None
+    return np.frombuffer(blob, dtype=np.float32)
+
+
+class GraphDeletedError(RuntimeError):
+    """The graph was deleted while work for it was in progress."""
+
+
+def _create_private_file(path: str) -> None:
+    os.close(os.open(path, os.O_CREAT | os.O_RDWR, 0o600))
+    os.chmod(path, 0o600)
+
+
+class GraphStore:
+    """Thread-safe SQLite store for graphs, episodes, nodes, edges and batches.
+
+    Single-process only: an exclusive lock file stops a second backend process (for example
+    several gunicorn workers) from opening the same database.
+    """
+
+    def __init__(self, path: str):
+        directory = os.path.dirname(os.path.abspath(path))
+        if not os.path.isdir(directory):
+            os.makedirs(directory, mode=0o700)
+            os.chmod(directory, 0o700)
+        self.path = path
+        _create_private_file(f"{path}.lock")
+        self._lock_file = open(f"{path}.lock", "r+")
+        try:
+            fcntl.flock(self._lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as error:
+            self._lock_file.close()
+            raise RuntimeError(f"another process is using the local graph database {path}") from error
+        _create_private_file(path)
+        self._lock = threading.RLock()
+        self._tx_depth = 0
+        self._conn = sqlite3.connect(path, check_same_thread=False, isolation_level=None)
+        self._conn.row_factory = sqlite3.Row
+        with self._lock:
+            self._conn.execute("PRAGMA foreign_keys = ON")
+            # Overwrite deleted content with zeros so purged seed text does not linger in free pages.
+            self._conn.execute("PRAGMA secure_delete = ON")
+            self._conn.executescript(_SCHEMA)
+        self._seq = self._max_seq()
+
+    # ------------------------------------------------------------------ helpers
+
+    def _max_seq(self) -> int:
+        row = self._conn.execute(
+            "SELECT MAX(s) FROM (SELECT MAX(seq) AS s FROM nodes UNION ALL "
+            "SELECT MAX(seq) FROM edges UNION ALL SELECT MAX(seq) FROM batches)"
+        ).fetchone()
+        return int(row[0] or 0)
+
+    def _next_seq(self) -> int:
+        self._seq += 1
+        return self._seq
+
+    @contextmanager
+    def transaction(self):
+        """Run statements atomically under the store lock. Nested calls join the outer one."""
+        with self._lock:
+            if self._tx_depth:
+                self._tx_depth += 1
+                try:
+                    yield self
+                finally:
+                    self._tx_depth -= 1
+                return
+            self._conn.execute("BEGIN IMMEDIATE")
+            self._tx_depth = 1
+            try:
+                yield self
+            except BaseException:
+                self._conn.execute("ROLLBACK")
+                raise
+            else:
+                self._conn.execute("COMMIT")
+            finally:
+                self._tx_depth = 0
+
+    def require_graph(self, graph_id: str) -> None:
+        """Raise GraphDeletedError if the graph no longer exists (call inside a transaction)."""
+        if not self._query("SELECT 1 FROM graphs WHERE graph_id = ?", (graph_id,)):
+            raise GraphDeletedError(graph_id)
+
+    def _query(self, sql: str, params: Sequence[Any] = ()) -> List[sqlite3.Row]:
+        with self._lock:
+            return self._conn.execute(sql, params).fetchall()
+
+    def _exec(self, sql: str, params: Sequence[Any] = ()) -> None:
+        with self._lock:
+            self._conn.execute(sql, params)
+
+    def close(self) -> None:
+        with self._lock:
+            self._conn.close()
+            self._lock_file.close()
+
+    # ------------------------------------------------------------------- graphs
+
+    def create_graph(self, graph_id: str, name: str, description: str) -> Graph:
+        created = utc_now()
+        with self._lock:
+            self._conn.execute(
+                "INSERT INTO graphs (graph_id, name, description, created_at) VALUES (?, ?, ?, ?)",
+                (graph_id, name, description or "", created),
+            )
+        return Graph(graph_id=graph_id, name=name, description=description or "", created_at=created)
+
+    def get_graph(self, graph_id: str) -> Optional[Graph]:
+        rows = self._query("SELECT * FROM graphs WHERE graph_id = ?", (graph_id,))
+        if not rows:
+            return None
+        r = rows[0]
+        return Graph(graph_id=r["graph_id"], name=r["name"], description=r["description"], created_at=r["created_at"])
+
+    def delete_graph(self, graph_id: str) -> None:
+        with self.transaction():
+            for table in ("edges", "nodes", "episodes", "batch_items"):
+                self._conn.execute(f"DELETE FROM {table} WHERE graph_id = ?", (graph_id,))
+            self._conn.execute(
+                "DELETE FROM batches WHERE json_extract(metadata_json, '$.graph_id') = ? "
+                "AND NOT EXISTS (SELECT 1 FROM batch_items i WHERE i.batch_id = batches.batch_id)",
+                (graph_id,),
+            )
+            self._conn.execute("DELETE FROM graphs WHERE graph_id = ?", (graph_id,))
+
+    def set_ontology(self, graph_id: str, ontology: Dict[str, Any]) -> None:
+        self._exec(
+            "UPDATE graphs SET ontology_json = ? WHERE graph_id = ?",
+            (json.dumps(ontology, ensure_ascii=False), graph_id),
+        )
+
+    def get_ontology(self, graph_id: str) -> Dict[str, Any]:
+        rows = self._query("SELECT ontology_json FROM graphs WHERE graph_id = ?", (graph_id,))
+        if not rows or not rows[0]["ontology_json"]:
+            return {"entity_types": [], "edge_types": []}
+        return json.loads(rows[0]["ontology_json"])
+
+    # ----------------------------------------------------------------- episodes
+
+    def add_episode(
+        self,
+        graph_id: str,
+        content: str,
+        *,
+        source_description: str = "",
+        metadata: Optional[Dict[str, Any]] = None,
+        created_at: Optional[str] = None,
+        episode_uuid: Optional[str] = None,
+    ) -> Episode:
+        episode = Episode(
+            uuid_=episode_uuid or str(uuid.uuid4()),
+            graph_id=graph_id,
+            content=content,
+            source_description=source_description or "",
+            metadata=dict(metadata or {}),
+            created_at=created_at or utc_now(),
+            processed=False,
+        )
+        self._exec(
+            "INSERT INTO episodes (uuid, graph_id, content, source_description, metadata_json, created_at) "
+            "VALUES (?, ?, ?, ?, ?, ?)",
+            (
+                episode.uuid_,
+                graph_id,
+                content,
+                episode.source_description,
+                json.dumps(episode.metadata, ensure_ascii=False, default=str),
+                episode.created_at,
+            ),
+        )
+        return episode
+
+    @staticmethod
+    def _row_to_episode(r: sqlite3.Row) -> Episode:
+        return Episode(
+            uuid_=r["uuid"],
+            graph_id=r["graph_id"],
+            content=r["content"],
+            source_description=r["source_description"],
+            metadata=json.loads(r["metadata_json"] or "{}"),
+            created_at=r["created_at"],
+            processed=bool(r["processed"]),
+            error=r["error"],
+        )
+
+    def get_episode(self, episode_uuid: str) -> Optional[Episode]:
+        rows = self._query("SELECT * FROM episodes WHERE uuid = ?", (episode_uuid,))
+        return self._row_to_episode(rows[0]) if rows else None
+
+    def get_episodes(self, episode_uuids: Iterable[str]) -> List[Episode]:
+        ids = list(episode_uuids)
+        if not ids:
+            return []
+        placeholders = ",".join("?" for _ in ids)
+        rows = self._query(f"SELECT * FROM episodes WHERE uuid IN ({placeholders})", ids)
+        by_id = {r["uuid"]: self._row_to_episode(r) for r in rows}
+        return [by_id[i] for i in ids if i in by_id]
+
+    def mark_episodes(self, episode_uuids: Iterable[str], *, error: Optional[str] = None) -> None:
+        with self.transaction():
+            for episode_uuid in episode_uuids:
+                self._conn.execute(
+                    "UPDATE episodes SET processed = 1, error = ? WHERE uuid = ?", (error, episode_uuid)
+                )
+
+    def unprocessed_standalone_episodes(self) -> List[Episode]:
+        """Episodes added via graph.add (not batch items) that still need extraction."""
+        rows = self._query(
+            "SELECT e.* FROM episodes e WHERE e.processed = 0 AND NOT EXISTS "
+            "(SELECT 1 FROM batch_items b WHERE b.episode_uuid = e.uuid) ORDER BY e.created_at"
+        )
+        return [self._row_to_episode(r) for r in rows]
+
+    # -------------------------------------------------------------------- nodes
+
+    @staticmethod
+    def _row_to_node(r: sqlite3.Row) -> Node:
+        return Node(
+            uuid_=r["uuid"],
+            graph_id=r["graph_id"],
+            name=r["name"],
+            labels=json.loads(r["labels_json"]),
+            summary=r["summary"],
+            attributes=json.loads(r["attributes_json"] or "{}"),
+            created_at=r["created_at"],
+        )
+
+    def list_nodes(self, graph_id: str, offset: int, limit: int) -> List[Node]:
+        rows = self._query(
+            "SELECT * FROM nodes WHERE graph_id = ? ORDER BY seq LIMIT ? OFFSET ?", (graph_id, limit, offset)
+        )
+        return [self._row_to_node(r) for r in rows]
+
+    def get_node(self, node_uuid: str) -> Optional[Node]:
+        rows = self._query("SELECT * FROM nodes WHERE uuid = ?", (node_uuid,))
+        return self._row_to_node(rows[0]) if rows else None
+
+    def find_node_by_key(self, graph_id: str, name_key: str) -> Optional[Node]:
+        rows = self._query("SELECT * FROM nodes WHERE graph_id = ? AND name_key = ? LIMIT 1", (graph_id, name_key))
+        return self._row_to_node(rows[0]) if rows else None
+
+    def node_summary_from_facts(self, node_uuid: str) -> bool:
+        rows = self._query("SELECT summary_from_facts FROM nodes WHERE uuid = ?", (node_uuid,))
+        return bool(rows and rows[0][0])
+
+    def insert_node(
+        self,
+        graph_id: str,
+        name: str,
+        name_key: str,
+        labels: List[str],
+        summary: str,
+        attributes: Dict[str, Any],
+        embedding: Optional[np.ndarray],
+        created_at: str,
+    ) -> Node:
+        node_uuid = str(uuid.uuid4())
+        with self._lock:
+            self._conn.execute(
+                "INSERT INTO nodes (uuid, graph_id, name, name_key, labels_json, summary, summary_from_facts, "
+                "attributes_json, embedding, created_at, seq) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    node_uuid,
+                    graph_id,
+                    name,
+                    name_key,
+                    json.dumps(labels, ensure_ascii=False),
+                    summary,
+                    0 if summary else 1,
+                    json.dumps(attributes, ensure_ascii=False),
+                    _vec_to_blob(embedding),
+                    created_at,
+                    self._next_seq(),
+                ),
+            )
+        return Node(node_uuid, graph_id, name, labels, summary, attributes, created_at)
+
+    def update_node(
+        self,
+        node_uuid: str,
+        *,
+        labels: Optional[List[str]] = None,
+        summary: Optional[str] = None,
+        summary_from_facts: Optional[bool] = None,
+        attributes: Optional[Dict[str, Any]] = None,
+    ) -> None:
+        sets, params = [], []
+        if labels is not None:
+            sets.append("labels_json = ?")
+            params.append(json.dumps(labels, ensure_ascii=False))
+        if summary is not None:
+            sets.append("summary = ?")
+            params.append(summary)
+        if summary_from_facts is not None:
+            sets.append("summary_from_facts = ?")
+            params.append(1 if summary_from_facts else 0)
+        if attributes is not None:
+            sets.append("attributes_json = ?")
+            params.append(json.dumps(attributes, ensure_ascii=False))
+        if not sets:
+            return
+        params.append(node_uuid)
+        self._exec(f"UPDATE nodes SET {', '.join(sets)} WHERE uuid = ?", params)
+
+    def set_node_embedding(self, node_uuid: str, embedding: Optional[np.ndarray]) -> None:
+        self._exec("UPDATE nodes SET embedding = ? WHERE uuid = ?", (_vec_to_blob(embedding), node_uuid))
+
+    def node_vectors(self, graph_id: str) -> List[Tuple[Node, Optional[np.ndarray]]]:
+        rows = self._query("SELECT * FROM nodes WHERE graph_id = ? ORDER BY seq", (graph_id,))
+        return [(self._row_to_node(r), _blob_to_vec(r["embedding"])) for r in rows]
+
+    # -------------------------------------------------------------------- edges
+
+    @staticmethod
+    def _row_to_edge(r: sqlite3.Row) -> Edge:
+        return Edge(
+            uuid_=r["uuid"],
+            graph_id=r["graph_id"],
+            name=r["name"],
+            fact=r["fact"],
+            source_node_uuid=r["source_uuid"],
+            target_node_uuid=r["target_uuid"],
+            attributes=json.loads(r["attributes_json"] or "{}"),
+            episodes=json.loads(r["episodes_json"] or "[]"),
+            created_at=r["created_at"],
+            valid_at=r["valid_at"],
+        )
+
+    def list_edges(self, graph_id: str, offset: int, limit: int) -> List[Edge]:
+        rows = self._query(
+            "SELECT * FROM edges WHERE graph_id = ? ORDER BY seq LIMIT ? OFFSET ?", (graph_id, limit, offset)
+        )
+        return [self._row_to_edge(r) for r in rows]
+
+    def edges_for_node(self, node_uuid: str) -> List[Edge]:
+        rows = self._query(
+            "SELECT * FROM edges WHERE source_uuid = ? OR target_uuid = ? ORDER BY seq", (node_uuid, node_uuid)
+        )
+        return [self._row_to_edge(r) for r in rows]
+
+    def find_edge(self, graph_id: str, source_uuid: str, target_uuid: str, name: str, fact_key: str) -> Optional[Edge]:
+        rows = self._query(
+            "SELECT * FROM edges WHERE graph_id = ? AND source_uuid = ? AND target_uuid = ? AND name = ? "
+            "AND fact_key = ? LIMIT 1",
+            (graph_id, source_uuid, target_uuid, name, fact_key),
+        )
+        return self._row_to_edge(rows[0]) if rows else None
+
+    def insert_edge(
+        self,
+        graph_id: str,
+        name: str,
+        fact: str,
+        fact_key: str,
+        source_uuid: str,
+        target_uuid: str,
+        attributes: Dict[str, Any],
+        episodes: List[str],
+        embedding: Optional[np.ndarray],
+        created_at: str,
+        valid_at: Optional[str],
+    ) -> Edge:
+        edge_uuid = str(uuid.uuid4())
+        with self._lock:
+            self._conn.execute(
+                "INSERT INTO edges (uuid, graph_id, name, fact, fact_key, source_uuid, target_uuid, "
+                "attributes_json, episodes_json, embedding, created_at, valid_at, seq) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+                (
+                    edge_uuid,
+                    graph_id,
+                    name,
+                    fact,
+                    fact_key,
+                    source_uuid,
+                    target_uuid,
+                    json.dumps(attributes, ensure_ascii=False),
+                    json.dumps(episodes),
+                    _vec_to_blob(embedding),
+                    created_at,
+                    valid_at,
+                    self._next_seq(),
+                ),
+            )
+        return Edge(edge_uuid, graph_id, name, fact, source_uuid, target_uuid, attributes, episodes, created_at, valid_at)
+
+    def add_edge_episodes(self, edge_uuid: str, episode_uuids: Iterable[str]) -> None:
+        with self._lock:
+            rows = self._conn.execute("SELECT episodes_json FROM edges WHERE uuid = ?", (edge_uuid,)).fetchall()
+            if not rows:
+                return
+            current = json.loads(rows[0][0] or "[]")
+            merged = current + [e for e in episode_uuids if e not in current]
+            self._conn.execute("UPDATE edges SET episodes_json = ? WHERE uuid = ?", (json.dumps(merged), edge_uuid))
+
+    def edge_vectors(self, graph_id: str) -> List[Tuple[Edge, Optional[np.ndarray]]]:
+        rows = self._query("SELECT * FROM edges WHERE graph_id = ? ORDER BY seq", (graph_id,))
+        return [(self._row_to_edge(r), _blob_to_vec(r["embedding"])) for r in rows]
+
+    # ------------------------------------------------------------------ batches
+
+    def create_batch(self, metadata: Dict[str, Any]) -> str:
+        batch_id = str(uuid.uuid4())
+        with self._lock:
+            self._conn.execute(
+                "INSERT INTO batches (batch_id, status, metadata_json, created_at, seq) VALUES (?, 'draft', ?, ?, ?)",
+                (batch_id, json.dumps(metadata or {}, ensure_ascii=False, default=str), utc_now(), self._next_seq()),
+            )
+        return batch_id
+
+    def _batch_progress(self, batch_id: str) -> BatchProgress:
+        rows = self._query("SELECT status, COUNT(*) FROM batch_items WHERE batch_id = ? GROUP BY status", (batch_id,))
+        counts = {r[0]: r[1] for r in rows}
+        total = sum(counts.values())
+        succeeded = counts.get("succeeded", 0)
+        failed = counts.get("failed", 0)
+        pending = total - succeeded - failed
+        percent = 100.0 * (succeeded + failed) / total if total else 0.0
+        return BatchProgress(total, succeeded, failed, pending, percent)
+
+    def _row_to_batch(self, r: sqlite3.Row) -> Batch:
+        return Batch(
+            batch_id=r["batch_id"],
+            status=r["status"],
+            metadata=json.loads(r["metadata_json"] or "{}"),
+            created_at=r["created_at"],
+            progress=self._batch_progress(r["batch_id"]),
+        )
+
+    def get_batch(self, batch_id: str) -> Optional[Batch]:
+        rows = self._query("SELECT * FROM batches WHERE batch_id = ?", (batch_id,))
+        return self._row_to_batch(rows[0]) if rows else None
+
+    def list_batches(self, offset: int, limit: int) -> List[Batch]:
+        rows = self._query("SELECT * FROM batches ORDER BY seq LIMIT ? OFFSET ?", (limit, offset))
+        return [self._row_to_batch(r) for r in rows]
+
+    def batches_with_status(self, status: str) -> List[Batch]:
+        rows = self._query("SELECT * FROM batches WHERE status = ? ORDER BY seq", (status,))
+        return [self._row_to_batch(r) for r in rows]
+
+    def set_batch_status(self, batch_id: str, status: str) -> None:
+        self._exec("UPDATE batches SET status = ? WHERE batch_id = ?", (status, batch_id))
+
+    def add_batch_items(self, batch_id: str, items: List[Dict[str, Any]]) -> List[BatchItem]:
+        """Append items (dicts with graph_id, data, source_description, metadata, created_at)."""
+        created: List[BatchItem] = []
+        with self.transaction():
+            row = self._conn.execute(
+                "SELECT COALESCE(MAX(sequence_index), -1) FROM batch_items WHERE batch_id = ?", (batch_id,)
+            ).fetchone()
+            next_index = int(row[0]) + 1
+            for offset, item in enumerate(items):
+                episode = self.add_episode(
+                    item["graph_id"],
+                    item["data"],
+                    source_description=item.get("source_description") or "",
+                    metadata=item.get("metadata") or {},
+                    created_at=item.get("created_at"),
+                )
+                index = next_index + offset
+                self._conn.execute(
+                    "INSERT INTO batch_items (batch_id, sequence_index, graph_id, status, episode_uuid) "
+                    "VALUES (?, ?, ?, 'pending', ?)",
+                    (batch_id, index, item["graph_id"], episode.uuid_),
+                )
+                created.append(BatchItem(batch_id, index, item["graph_id"], "pending", episode.uuid_, episode.uuid_))
+        return created
+
+    def list_batch_items(self, batch_id: str, offset: int = 0, limit: int = 1_000_000) -> List[BatchItem]:
+        rows = self._query(
+            "SELECT * FROM batch_items WHERE batch_id = ? ORDER BY sequence_index LIMIT ? OFFSET ?",
+            (batch_id, limit, offset),
+        )
+        return [
+            BatchItem(r["batch_id"], r["sequence_index"], r["graph_id"], r["status"], r["episode_uuid"],
+                      r["episode_uuid"], r["error"])
+            for r in rows
+        ]
+
+    def set_items_status(self, batch_id: str, indexes: Iterable[int], status: str, error: Optional[str] = None) -> None:
+        with self.transaction():
+            for index in indexes:
+                self._conn.execute(
+                    "UPDATE batch_items SET status = ?, error = ? WHERE batch_id = ? AND sequence_index = ?",
+                    (status, error, batch_id, index),
+                )
