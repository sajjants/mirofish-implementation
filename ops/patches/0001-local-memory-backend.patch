+"""Keep the test suite hermetic: never read the developer's mirofish/.env.
+
+app/config.py loads .env with override=True at import, so a local setup
+(for example MIROFISH_MEMORY_BACKEND=local) would otherwise change what the
+Zep Cloud client tests exercise.
+"""
+
+import os
+
+import dotenv
+
+dotenv.load_dotenv = lambda *args, **kwargs: False
+
+for _name in list(os.environ):
+    if _name == "MIROFISH_MEMORY_BACKEND" or _name.startswith("LOCAL_GRAPH_"):
+        del os.environ[_name]
