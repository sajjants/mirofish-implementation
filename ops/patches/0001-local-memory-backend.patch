@@ -0,0 +1,53 @@
+"""Local graph-memory backend replacing Zep Cloud (enabled by MIROFISH_MEMORY_BACKEND=local).
+
+Storage is an SQLite file under the uploads folder; extraction uses the configured LLM
+(expected to be a local Ollama endpoint) and embeddings come from a loopback Ollama server.
+"""
+
+from __future__ import annotations
+
+import os
+import threading
+from typing import Any, Optional
+
+from .client import LocalZep
+from .embedder import OllamaEmbedder
+from .extractor import OntologyExtractor
+from .ingest import GraphIngestor
+from .store import GraphStore
+from .worker import IngestWorker
+
+_client: Optional[LocalZep] = None
+_client_lock = threading.Lock()
+
+
+def default_db_path() -> str:
+    from ..config import Config
+
+    return os.environ.get("LOCAL_GRAPH_DB_PATH") or os.path.join(
+        os.path.abspath(Config.UPLOAD_FOLDER), "local_graph", "graph.sqlite3"
+    )
+
+
+def build_local_graph_client(
+    db_path: str,
+    *,
+    embedder: Any = None,
+    extractor: Optional[OntologyExtractor] = None,
+) -> LocalZep:
+    store = GraphStore(db_path)
+    embedder = embedder or OllamaEmbedder()
+    worker = IngestWorker(store, GraphIngestor(store, extractor or OntologyExtractor(), embedder))
+    worker.recover()
+    return LocalZep(store, worker, embedder)
+
+
+def get_local_graph_client() -> LocalZep:
+    global _client
+    with _client_lock:
+        if _client is None:
+            _client = build_local_graph_client(default_db_path())
+        return _client
+
+
+__all__ = ["LocalZep", "build_local_graph_client", "get_local_graph_client", "default_db_path"]
diff --git a/backend/app/local_graph/client.py b/backend/app/local_graph/client.py
new file mode 100644
index 0000000..612d8ec
--- /dev/null
+++ b/backend/app/local_graph/client.py
@@ -0,0 +1,248 @@
+"""Drop-in replacement for the subset of ``zep_cloud.client.Zep`` that MiroFish uses.
+
+Namespaces and method names match zep-cloud 3.25.0; missing records raise
+``zep_cloud.NotFoundError`` so MiroFish's existing error handling applies unchanged.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+from zep_cloud import NotFoundError
+from zep_cloud.core.api_error import ApiError
+from zep_cloud.types.api_error import ApiError as ApiErrorBody
+
+from .extractor import ontology_from_zep_models
+from .models import BatchItemsPage, BatchListPage, Episode, RawResponse, SearchResults
+from .search import hybrid_rank
+from .store import GraphStore, utc_now
+from .worker import IngestWorker
+
+NEXT_CURSOR_HEADER = "zep-next-cursor"
+VALID_SCOPES = {"edges", "nodes"}
+
+
+def _not_found(what: str) -> NotFoundError:
+    return NotFoundError(body=ApiErrorBody(message=f"{what} not found"))
+
+
+def _bad_request(message: str) -> ApiError:
+    return ApiError(status_code=400, body={"message": message})
+
+
+def _offset(cursor: Any) -> int:
+    try:
+        return max(0, int(cursor or 0))
+    except (TypeError, ValueError) as error:
+        raise _bad_request("invalid cursor") from error
+
+
+class _Paged:
+    """``with_raw_response`` view returning data plus a ``zep-next-cursor`` header."""
+
+    def __init__(self, store: GraphStore, kind: str):
+        self._store = store
+        self._kind = kind
+
+    def get_by_graph_id(self, graph_id: str, *, limit: int = 100, cursor: Any = None, **_: Any) -> RawResponse:
+        if self._store.get_graph(graph_id) is None:
+            raise _not_found(f"graph {graph_id}")
+        offset = _offset(cursor)
+        fetch = self._store.list_nodes if self._kind == "nodes" else self._store.list_edges
+        page = fetch(graph_id, offset, limit + 1)
+        headers = {NEXT_CURSOR_HEADER: str(offset + limit)} if len(page) > limit else {}
+        return RawResponse(data=page[:limit], headers=headers)
+
+
+class _NodeClient:
+    def __init__(self, store: GraphStore):
+        self._store = store
+        self.with_raw_response = _Paged(store, "nodes")
+
+    def get(self, uuid_: str, **_: Any):
+        node = self._store.get_node(uuid_)
+        if node is None:
+            raise _not_found(f"node {uuid_}")
+        return node
+
+    def get_edges(self, node_uuid: str, **_: Any):
+        if self._store.get_node(node_uuid) is None:
+            raise _not_found(f"node {node_uuid}")
+        return self._store.edges_for_node(node_uuid)
+
+
+class _EdgeClient:
+    def __init__(self, store: GraphStore):
+        self._store = store
+        self.with_raw_response = _Paged(store, "edges")
+
+
+class _EpisodeClient:
+    def __init__(self, store: GraphStore):
+        self._store = store
+
+    def get(self, uuid_: str, **_: Any) -> Episode:
+        episode = self._store.get_episode(uuid_)
+        if episode is None:
+            raise _not_found(f"episode {uuid_}")
+        return episode
+
+
+class _GraphClient:
+    def __init__(self, store: GraphStore, worker: IngestWorker, embedder: Any):
+        self._store = store
+        self._worker = worker
+        self._embedder = embedder
+        self.node = _NodeClient(store)
+        self.edge = _EdgeClient(store)
+        self.episode = _EpisodeClient(store)
+
+    def create(self, *, graph_id: str, name: Optional[str] = None, description: Optional[str] = None, **_: Any):
+        if not graph_id:
+            raise _bad_request("graph_id is required")
+        if self._store.get_graph(graph_id) is not None:
+            raise ApiError(status_code=409, body={"message": f"graph {graph_id} already exists"})
+        return self._store.create_graph(graph_id, name or graph_id, description or "")
+
+    def get(self, graph_id: str, **_: Any):
+        graph = self._store.get_graph(graph_id)
+        if graph is None:
+            raise _not_found(f"graph {graph_id}")
+        return graph
+
+    def delete(self, graph_id: str, **_: Any) -> None:
+        if self._store.get_graph(graph_id) is None:
+            raise _not_found(f"graph {graph_id}")
+        self._store.delete_graph(graph_id)
+
+    def set_ontology(
+        self,
+        *,
+        entities: Optional[Dict[str, Any]] = None,
+        edges: Optional[Dict[str, Any]] = None,
+        graph_ids: Optional[List[str]] = None,
+        **_: Any,
+    ) -> None:
+        if not graph_ids:
+            raise _bad_request("graph_ids is required")
+        ontology = ontology_from_zep_models(entities, edges)
+        for graph_id in graph_ids:
+            if self._store.get_graph(graph_id) is None:
+                raise _not_found(f"graph {graph_id}")
+            self._store.set_ontology(graph_id, ontology)
+
+    def add(
+        self,
+        *,
+        data: str,
+        type: str = "text",  # noqa: A002 - matches the zep-cloud keyword
+        graph_id: Optional[str] = None,
+        created_at: Optional[str] = None,
+        source_description: Optional[str] = None,
+        metadata: Optional[Dict[str, Any]] = None,
+        **_: Any,
+    ) -> Episode:
+        if not graph_id or self._store.get_graph(graph_id) is None:
+            raise _not_found(f"graph {graph_id}")
+        if type not in {"text", "message", "json"}:
+            raise _bad_request(f"unsupported episode type {type!r}")
+        episode = self._store.add_episode(
+            graph_id, data, source_description=source_description or "", metadata=metadata,
+            created_at=created_at or utc_now(),
+        )
+        self._worker.submit_episode(episode.uuid_)
+        return episode
+
+    def search(
+        self,
+        *,
+        query: str,
+        graph_id: Optional[str] = None,
+        limit: int = 10,
+        scope: str = "edges",
+        reranker: Optional[str] = None,  # rrf and cross_encoder both use hybrid fusion
+        **_: Any,
+    ) -> SearchResults:
+        if not graph_id or self._store.get_graph(graph_id) is None:
+            raise _not_found(f"graph {graph_id}")
+        if scope not in VALID_SCOPES:
+            raise _bad_request(f"unsupported scope {scope!r}")
+        if not isinstance(query, str) or not query.strip():
+            raise _bad_request("query must be a non-empty string")
+        limit = max(1, min(int(limit), 50))
+        query_vector = self._embedder.embed([query])[0]
+        if scope == "edges":
+            candidates = [(e, f"{e.name} {e.fact}", v) for e, v in self._store.edge_vectors(graph_id)]
+            return SearchResults(edges=hybrid_rank(query, query_vector, candidates, limit))
+        candidates = [(n, f"{n.name} {n.summary}", v) for n, v in self._store.node_vectors(graph_id)]
+        return SearchResults(nodes=hybrid_rank(query, query_vector, candidates, limit))
+
+
+class _BatchClient:
+    def __init__(self, store: GraphStore, worker: IngestWorker):
+        self._store = store
+        self._worker = worker
+
+    def _require(self, batch_id: str):
+        batch = self._store.get_batch(batch_id)
+        if batch is None:
+            raise _not_found(f"batch {batch_id}")
+        return batch
+
+    def create(self, *, metadata: Optional[Dict[str, Any]] = None, **_: Any):
+        return self._require(self._store.create_batch(metadata or {}))
+
+    def add(self, *, batch_id: str, items: List[Any], **_: Any):
+        batch = self._require(batch_id)
+        if batch.status != "draft":
+            raise _bad_request(f"batch {batch_id} is {batch.status}, not draft")
+        rows = []
+        for item in items:
+            item_type = getattr(item, "type", None)
+            graph_id = getattr(item, "graph_id", None)
+            data = getattr(item, "data", None) or getattr(item, "content", None)
+            if item_type != "graph_episode":
+                raise _bad_request(f"unsupported batch item type {item_type!r}")
+            if not graph_id or self._store.get_graph(graph_id) is None:
+                raise _not_found(f"graph {graph_id}")
+            if not isinstance(data, str) or not data:
+                raise _bad_request("batch item data must be a non-empty string")
+            rows.append({
+                "graph_id": graph_id,
+                "data": data,
+                "source_description": getattr(item, "source_description", None) or "",
+                "metadata": getattr(item, "metadata", None) or {},
+                "created_at": getattr(item, "created_at", None),
+            })
+        return self._store.add_batch_items(batch_id, rows)
+
+    def process(self, *, batch_id: str, **_: Any):
+        batch = self._require(batch_id)
+        if batch.status == "draft":
+            self._store.set_batch_status(batch_id, "processing")
+            self._worker.submit_batch(batch_id)
+        return self._require(batch_id)
+
+    def get(self, *, batch_id: str, **_: Any):
+        return self._require(batch_id)
+
+    def list(self, *, limit: int = 100, cursor: Any = None, **_: Any) -> BatchListPage:
+        offset = _offset(cursor)
+        page = self._store.list_batches(offset, limit + 1)
+        return BatchListPage(batches=page[:limit], next_cursor=offset + limit if len(page) > limit else None)
+
+    def list_items(self, *, batch_id: str, limit: int = 100, cursor: Any = None, **_: Any) -> BatchItemsPage:
+        self._require(batch_id)
+        offset = _offset(cursor)
+        page = self._store.list_batch_items(batch_id, offset, limit + 1)
+        return BatchItemsPage(items=page[:limit], next_cursor=offset + limit if len(page) > limit else None)
+
+
+class LocalZep:
+    """Process-local graph memory with the zep-cloud client surface MiroFish calls."""
+
+    def __init__(self, store: GraphStore, worker: IngestWorker, embedder: Any):
+        self.store = store
+        self.worker = worker
+        self.graph = _GraphClient(store, worker, embedder)
+        self.batch = _BatchClient(store, worker)
