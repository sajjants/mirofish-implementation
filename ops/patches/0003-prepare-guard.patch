+_prepare_lock = threading.Lock()
+_preparing_ids = set()
+
+
+def _reserve_prepare(simulation_id):
+    with _prepare_lock:
+        if simulation_id in _preparing_ids:
+            return False
+        _preparing_ids.add(simulation_id)
+        return True
+
+
+def _release_prepare(simulation_id):
+    with _prepare_lock:
+        _preparing_ids.discard(simulation_id)
+
+
+def _guard_prepare(view):
+    """One prepare task per simulation at a time.
+
+    Without this, a second /prepare (e.g. the Step 2 page) while a task runs starts another task that
+    overwrites the first one's profiles and config: _check_simulation_prepared only sees finished work.
+    The reservation is held until the background task ends; the view sets g.prepare_started once it
+    has handed the reservation to that task.
+    """
+    @functools.wraps(view)
+    def wrapper(*args, **kwargs):
+        simulation_id = (request.get_json(silent=True) or {}).get('simulation_id')
+        if not simulation_id:
+            return view(*args, **kwargs)
+        if not _reserve_prepare(simulation_id):
+            return jsonify({
+                "success": False,
+                "error": f"A prepare task is already running for {simulation_id}; wait for it to finish."
+            }), 409
+        g.prepare_started = False
+        try:
+            return view(*args, **kwargs)
+        finally:
+            if not g.prepare_started:
+                _release_prepare(simulation_id)
+    return wrapper
+
