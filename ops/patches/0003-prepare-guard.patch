diff --git a/backend/app/utils/wrapper_token.py b/backend/app/utils/wrapper_token.py
new file mode 100644
index 0000000..d6512d1
--- /dev/null
+++ b/backend/app/utils/wrapper_token.py
@@ -0,0 +1,28 @@
+"""Routes reserved for a wrapper that drives the API (MIROFISH_WRAPPER_TOKEN).
+
+When MIROFISH_WRAPPER_TOKEN is set, decorated routes answer 403 unless the request sends it in
+X-MiroFish-Wrapper-Token. The web page cannot know the token, so it cannot start that work while
+the wrapper owns the run. Unset, upstream behaviour is unchanged.
+"""
+
+import functools
+import hmac
+import os
+
+from flask import jsonify, request
+
+WRAPPER_TOKEN_HEADER = 'X-MiroFish-Wrapper-Token'
+
+
+def require_wrapper_token(view):
+    @functools.wraps(view)
+    def wrapper(*args, **kwargs):
+        token = os.environ.get('MIROFISH_WRAPPER_TOKEN', '')
+        if token and not hmac.compare_digest(request.headers.get(WRAPPER_TOKEN_HEADER, ''), token):
+            return jsonify({
+                "success": False,
+                "error": "This server does this only for the wrapper that started it "
+                         "(MIROFISH_WRAPPER_TOKEN is set)."
+            }), 403
+        return view(*args, **kwargs)
+    return wrapper
diff --git a/backend/tests/test_simulation_prepare_guard.py b/backend/tests/test_simulation_prepare_guard.py
new file mode 100644
index 0000000..33b1867
--- /dev/null
+++ b/backend/tests/test_simulation_prepare_guard.py
@@ -0,0 +1,103 @@
+"""/api/simulation/prepare: one task per simulation at a time; MIROFISH_WRAPPER_TOKEN routes."""
+
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from app import create_app
+from app.api import simulation as simulation_api
+from app.services.simulation_manager import SimulationManager, SimulationState, SimulationStatus
+from app.utils.wrapper_token import WRAPPER_TOKEN_HEADER
+
+BASE_URL = "http://localhost:5001"
+TOKEN = "wrapper-token-for-tests-only"
+
+
+@pytest.fixture
+def client(monkeypatch):
+    monkeypatch.delenv("MIROFISH_WRAPPER_TOKEN", raising=False)
+    monkeypatch.setattr(simulation_api, "_preparing_ids", set())
+    return create_app().test_client()
+
+
+@pytest.fixture
+def blocking_prepare(monkeypatch):
+    """A simulation whose background prepare runs until `release` is set."""
+    release, finished = threading.Event(), threading.Event()
+    state = SimulationState(simulation_id="sim_guard", project_id="proj", graph_id="graph",
+                            status=SimulationStatus.CREATED)
+
+    def prepare_simulation(self, **kwargs):
+        release.wait(5)
+        finished.set()
+        return SimulationState(simulation_id="sim_guard", project_id="proj", graph_id="graph",
+                               status=SimulationStatus.READY)
+
+    class NoZep:
+        def filter_defined_entities(self, **kwargs):
+            raise RuntimeError("no Zep in tests")
+
+    monkeypatch.setattr(SimulationManager, "get_simulation", lambda self, sid: state if sid == "sim_guard" else None)
+    monkeypatch.setattr(SimulationManager, "_save_simulation_state", lambda self, s: None)
+    monkeypatch.setattr(SimulationManager, "prepare_simulation", prepare_simulation)
+    monkeypatch.setattr(simulation_api, "_check_simulation_prepared", lambda sid: (False, {}))
+    monkeypatch.setattr(simulation_api, "ZepEntityReader", NoZep)
+    monkeypatch.setattr(simulation_api.ProjectManager, "get_project",
+                        staticmethod(lambda pid: SimpleNamespace(simulation_requirement="requirement")))
+    monkeypatch.setattr(simulation_api.ProjectManager, "get_extracted_text", staticmethod(lambda pid: "text"))
+    yield SimpleNamespace(release=release, finished=finished)
+    release.set()
+
+
+def _prepare(client, simulation_id="sim_guard", headers=None):
+    return client.post("/api/simulation/prepare", json={"simulation_id": simulation_id},
+                       headers=headers or {}, base_url=BASE_URL)
+
+
+def test_second_prepare_is_refused_while_the_first_task_runs(client, blocking_prepare):
+    first = _prepare(client)
+    assert first.status_code == 200
+    assert first.get_json()["data"]["already_prepared"] is False
+
+    second = _prepare(client)
+    assert second.status_code == 409
+    assert "already running" in second.get_json()["error"]
+
+    blocking_prepare.release.set()
+    assert blocking_prepare.finished.wait(5)
+    deadline = time.monotonic() + 5
+    while "sim_guard" in simulation_api._preparing_ids and time.monotonic() < deadline:
+        time.sleep(0.02)
+    assert _prepare(client).status_code == 200
+
+
+def test_a_request_that_starts_no_task_releases_the_simulation(client):
+    assert _prepare(client, "sim_missing").status_code == 404
+    assert _prepare(client, "sim_missing").status_code == 404
+    assert simulation_api._preparing_ids == set()
+
+
+def test_token_is_required_for_prepare_when_configured(client, monkeypatch, blocking_prepare):
+    monkeypatch.setenv("MIROFISH_WRAPPER_TOKEN", TOKEN)
+    assert _prepare(client).status_code == 403
+    assert _prepare(client, headers={WRAPPER_TOKEN_HEADER: "wrong"}).status_code == 403
+    assert simulation_api._preparing_ids == set()
+    assert _prepare(client, headers={WRAPPER_TOKEN_HEADER: TOKEN}).status_code == 200
+
+
+@pytest.mark.parametrize("path", ["/api/simulation/create", "/api/report/generate"])
+def test_token_is_required_to_create_simulations_and_generate_reports(client, monkeypatch, path):
+    monkeypatch.setenv("MIROFISH_WRAPPER_TOKEN", TOKEN)
+    refused = client.post(path, json={}, base_url=BASE_URL)
+    assert refused.status_code == 403
+    assert "MIROFISH_WRAPPER_TOKEN" in refused.get_json()["error"]
+    # With the token the route's own validation runs (missing ids).
+    allowed = client.post(path, json={}, headers={WRAPPER_TOKEN_HEADER: TOKEN}, base_url=BASE_URL)
+    assert allowed.status_code == 400
+
+
+def test_no_token_configured_keeps_upstream_behaviour(client):
+    assert _prepare(client, "sim_missing").status_code == 404
+    assert client.post("/api/simulation/create", json={}, base_url=BASE_URL).status_code == 400
