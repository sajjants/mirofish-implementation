diff --git a/backend/tests/test_local_hardening.py b/backend/tests/test_local_hardening.py
new file mode 100644
index 0000000..ff50f5d
--- /dev/null
+++ b/backend/tests/test_local_hardening.py
@@ -0,0 +1,55 @@
+"""Opt-in hardening switches in create_app (MIROFISH_CORS_ORIGINS, MIROFISH_ALLOWED_HOSTS,
+MIROFISH_LOG_REQUEST_BODIES). Unset, upstream behaviour is unchanged."""
+
+import logging
+
+from app import create_app
+
+LOCAL_ORIGIN = "http://127.0.0.1:3000"
+
+
+def _client(monkeypatch, **env):
+    for name in ("MIROFISH_CORS_ORIGINS", "MIROFISH_ALLOWED_HOSTS", "MIROFISH_LOG_REQUEST_BODIES"):
+        monkeypatch.delenv(name, raising=False)
+    for name, value in env.items():
+        monkeypatch.setenv(name, value)
+    return create_app().test_client()
+
+
+def test_defaults_keep_upstream_behaviour(monkeypatch):
+    client = _client(monkeypatch)
+    response = client.get("/api/graph/project/list", headers={"Origin": "https://evil.example", "Host": "evil.example"})
+    assert response.status_code != 403
+    # flask-cors echoes any origin when configured with "*": every web page can read the API.
+    assert response.headers.get("Access-Control-Allow-Origin") == "https://evil.example"
+
+
+def test_cors_is_limited_to_configured_origins(monkeypatch):
+    client = _client(monkeypatch, MIROFISH_CORS_ORIGINS=f"{LOCAL_ORIGIN},http://localhost:3000")
+    allowed = client.get("/api/graph/project/list", headers={"Origin": LOCAL_ORIGIN})
+    assert allowed.headers.get("Access-Control-Allow-Origin") == LOCAL_ORIGIN
+    other = client.get("/api/graph/project/list", headers={"Origin": "https://evil.example"})
+    assert "Access-Control-Allow-Origin" not in other.headers
+
+
+def test_unknown_host_header_is_rejected(monkeypatch):
+    client = _client(monkeypatch, MIROFISH_ALLOWED_HOSTS="127.0.0.1:5001,localhost:5001")
+    assert client.get("/health", headers={"Host": "127.0.0.1:5001"}).status_code == 200
+    assert client.get("/health", headers={"Host": "LOCALHOST:5001"}).status_code == 200
+    rebound = client.get("/health", headers={"Host": "attacker.example:5001"})
+    assert rebound.status_code == 403
+    assert rebound.get_json() == {"success": False, "error": "host not allowed"}
+
+
+def test_request_bodies_are_not_logged_when_disabled(monkeypatch, caplog):
+    marker = "seed-derived-text-7f3a"
+    client = _client(monkeypatch, MIROFISH_LOG_REQUEST_BODIES="false")
+    request_logger = logging.getLogger("mirofish.request")
+    request_logger.addHandler(caplog.handler)
+    try:
+        with caplog.at_level(logging.DEBUG, logger="mirofish.request"):
+            client.post("/api/report/chat", json={"message": marker})
+    finally:
+        request_logger.removeHandler(caplog.handler)
+    assert marker not in caplog.text
+    assert "/api/report/chat" in caplog.text
