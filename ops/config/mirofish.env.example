# Template for mirofish/.env under the local-LLM path.
# Copy with: install -m 600 ops/config/mirofish.env.example mirofish/.env
# Do NOT copy upstream's .env.example: it ships placeholder LLM_BOOST_* values that
# redirect the Reddit simulation to a bogus endpoint.

# ----- LLM: local Ollama, OpenAI-compatible endpoint -----
# Any non-empty key works for Ollama; MiroFish refuses to start if it is empty.
LLM_API_KEY=ollama-local
# 11435 is ops/scripts/llm_meter.py (started by start.sh), which forwards to Ollama on 11434 and
# records per-call metadata for run_batch.py. Use 11434 to bypass it (calls are then unmeasured).
LLM_BASE_URL=http://127.0.0.1:11435/v1
# Must equal OLLAMA_MODEL_ALIAS in ops/config/model.conf
LLM_MODEL_NAME=mirofish-llm

# ----- Memory layer: local graph (ops/patches/0001-local-memory-backend.patch) -----
# Replaces Zep Cloud with SQLite + Ollama embeddings; ZEP_API_KEY is not needed.
# Never set ZEP_API_KEY here: seed content must not leave this machine.
MIROFISH_MEMORY_BACKEND=local
# Must equal EMBED_MODEL_ALIAS in ops/config/model.conf; the URL must be loopback.
LOCAL_GRAPH_EMBED_URL=http://127.0.0.1:11434
LOCAL_GRAPH_EMBED_MODEL=mirofish-embed
# Optional: database location (default mirofish/backend/uploads/local_graph/graph.sqlite3)
# LOCAL_GRAPH_DB_PATH=
# 1 = fail a graph build if any chunk cannot be extracted (default 0: record and continue,
# but fail if more than LOCAL_GRAPH_MAX_EXTRACTION_FAILURE_RATIO of the chunks failed)
LOCAL_GRAPH_STRICT_EXTRACTION=0
LOCAL_GRAPH_MAX_EXTRACTION_FAILURE_RATIO=0.5
# How long MiroFish waits for graph ingestion (upstream's Zep Cloud value is 600)
LOCAL_GRAPH_INGESTION_TIMEOUT_SECONDS=7200

# ----- Bind to loopback only -----
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=False
# Replace with the output of: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ----- Browser-facing hardening (ops/patches/0002-local-hardening.patch) -----
# Only the local frontend may read API responses; requests with any other Host header are
# refused (blocks DNS rebinding); JSON request bodies are not written to backend/logs.
MIROFISH_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MIROFISH_ALLOWED_HOSTS=127.0.0.1:5001,localhost:5001
MIROFISH_LOG_REQUEST_BODIES=false

# ----- Telemetry and tracing off -----
HF_HUB_DISABLE_TELEMETRY=1
# ops/scripts/cache_assets.sh downloads the Twitter recommender model and the tiktoken
# encodings once, sets HF_HOME and TIKTOKEN_CACHE_DIR to ops/cache, and flips these to 1.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=False
LANGFUSE_ENABLED=False
TRACEROOT_ENABLED=False
# Never set: LANGCHAIN_TRACING_V2, LANGSMITH_API_KEY, AGENTOPS_API_KEY
